# Incluir DENTRO do VirtualHost existente que atende 192.168.90.7:8082.
# Requer mod_alias, mod_dir, mod_mime, mod_authz_host e mod_headers.
# Nao adicionar Listen nem substituir o DocumentRoot do sistema interno.
RedirectMatch 302 "^/previa-cliente$" "/previa-cliente/"
Alias "/previa-cliente/" "/var/www/realponto-previa/current/public/"

<Directory "/var/www/realponto-previa/">
    Options -Indexes +FollowSymLinks -MultiViews -ExecCGI -Includes
    AllowOverride None
    DirectoryIndex index.html
    FallbackResource disabled
    AddType text/javascript .mjs

    # TI: adicionar as MESMAS redes/IPs de LAN/VPN permitidos no site interno.
    # Local-only ate essa adaptacao. Nao trocar por Require all granted.
    <RequireAny>
        Require local
        # Require ip REDE_OU_IP_AUTORIZADO
    </RequireAny>

    Header always set Cache-Control "no-store"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</Directory>
