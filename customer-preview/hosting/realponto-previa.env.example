# Somente a previa. A branch main do repositorio realponto-previa-cliente e fixa no atualizador.
PREVIEW_STATE_ROOT=/var/lib/realponto-previa
PREVIEW_DEPLOY_ROOT=/var/www/realponto-previa
PREVIEW_REPOSITORY=git@github.com:lucasprimitz/realponto-previa-cliente.git
PREVIEW_HEALTH_URL=http://192.168.90.7:8082/previa-cliente/
# A TI configura a chave de leitura e known_hosts do usuario realponto-previa.
GIT_SSH_COMMAND="/usr/bin/ssh -oBatchMode=yes -oStrictHostKeyChecking=yes -oConnectTimeout=15 -oServerAliveInterval=15 -oServerAliveCountMax=2"
